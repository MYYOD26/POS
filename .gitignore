# See https://git-scm.com/docs/gitignore for more about ignoring files.

# Ignore environment variable files
.env
.env.*

# Node modules
node_modules/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# OS generated files
.DS_Store
Thumbs.db

# Build outputs
dist/
build/

# IDE files
.vscode/
.idea/

# Others
*.swp
*.swo

